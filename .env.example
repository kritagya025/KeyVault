# Copy to .env and adjust. docker-compose reads this file automatically.
# For a bare `mvn spring-boot:run`, export these variables into your shell instead.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/keyvault_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
POSTGRES_DB=keyvault_db

# --- JWT signing ---
# Generate with: openssl rand -hex 32
# Must be at least 32 bytes. The app refuses to start with a shorter value.
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- Misc ---
SERVER_PORT=8080
LOG_LEVEL=INFO
